// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ORGANISER
  USER
}

model User {
  id               Int               @id @default(autoincrement())
  name             String?
  telephone        String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  postcode         String?
  country          String?
  username         String?           @unique
  email            String            @unique
  password         String
  role             Role              @default(USER)
  isSubscriber     Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  organiserProfile OrganiserProfile?
  videoPurchases   VideoPurchase[]
}

model OrganiserProfile {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug           String   @unique
  name           String
  organization   String?
  bio            String?  @db.Text
  website        String?
  avatarInitials String?
  profilePhotoUrl String?
  isVerified     Boolean  @default(false)
  isFounding     Boolean  @default(false)
  subscriptionPrice Float? @default(0)
  events         Event[]
  videos         Video[]
}

model Event {
  id              Int              @id @default(autoincrement())
  title           String
  format          String?
  description     String?          @db.Text
  date            String
  endDate         String?
  startTime       String?
  endTime         String?
  location        String?
  imageUrl        String?
  price           Decimal          @db.Decimal(10, 2)
  isPriceFrom     Boolean          @default(false)
  ticketingMethod String?
  ticketUrl       String?
  livestreamUrl   String?
  keynoteSpeakers String?
  status          String           @default("ACTIVE")
  isApproved      Boolean          @default(true)
  pendingEdits    Json?
  organiserId     Int
  organiser       OrganiserProfile @relation(fields: [organiserId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
}

model Video {
  id          Int              @id @default(autoincrement())
  title       String
  description String?          @db.Text
  thumbnailUrl String?
  videoUrl    String
  category    String?
  isFree      Boolean          @default(true)
  price       Decimal          @default(0.00) @db.Decimal(10, 2)
  isApproved  Boolean          @default(true)
  pendingEdits Json?
  organiserId Int
  organiser   OrganiserProfile @relation(fields: [organiserId], references: [id], onDelete: Cascade)
  purchases   VideoPurchase[]
  createdAt   DateTime         @default(now())
}

model VideoPurchase {
  id        Int      @id @default(autoincrement())
  userId    Int
  videoId   Int
  amount    Decimal  @db.Decimal(10, 2)
  status    String   @default("COMPLETED")
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
}

model SecurityLog {
  id        Int      @id @default(autoincrement())
  event     String
  ipAddress String?
  userId    Int?
  details   String?  @db.Text
  createdAt DateTime @default(now())
}

model SystemSetting {
  id    String @id
  value String
}

model LoungeParticipant {
  id        String   @id @default(uuid())
  tableId   Int
  socketId  String   @unique
  updatedAt DateTime @default(now())

  signalsSent     LoungeSignal[] @relation("SentSignals")
  signalsReceived LoungeSignal[] @relation("ReceivedSignals")
}

model LoungeSignal {
  id          Int      @id @default(autoincrement())
  senderId    String
  receiverId  String
  type        String
  payload     String   @db.Text
  createdAt   DateTime @default(now())
  
  sender      LoungeParticipant @relation("SentSignals", fields: [senderId], references: [socketId], onDelete: Cascade)
  receiver    LoungeParticipant @relation("ReceivedSignals", fields: [receiverId], references: [socketId], onDelete: Cascade)
}
